<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="COM_RA_LIBRARY_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_RA_LIBRARY_FILTER_STATE"
               description="COM_RA_LIBRARY_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="category_id"
               type="category"
               extension="com_ra_library.route"
               label="COM_RA_LIBRARY_PASTWALK_FIELD_CATID_LABEL"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_CATEGORY</option>
        </field>

        <field name="national_grade"
               type="list"
               label="COM_RA_LIBRARY_PASTWALK_FIELD_NATIONAL_GRADE_LABEL"
               onchange="this.form.submit();"
        >
            <option value="">COM_RA_LIBRARY_PASTWALK_SELECT_GRADE</option>
            <option value="Easy Access">Easy Access</option>
            <option value="Easy">Easy</option>
            <option value="Leisurely">Leisurely</option>
            <option value="Moderate">Moderate</option>
            <option value="Strenuous">Strenuous</option>
            <option value="Technical">Technical</option>
        </field>
    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_RA_LIBRARY_LIST_FULL_ORDERING"
               description="COM_RA_LIBRARY_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.title ASC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.title ASC">COM_RA_LIBRARY_TITLE_ASC</option>
            <option value="a.title DESC">COM_RA_LIBRARY_TITLE_DESC</option>
            <option value="a.state ASC">COM_RA_LIBRARY_STATE_ASC</option>
            <option value="a.state DESC">COM_RA_LIBRARY_STATE_DESC</option>
            <option value="a.national_grade ASC">COM_RA_LIBRARY_ROUTE_GRADE_ASC</option>
            <option value="a.national_grade DESC">COM_RA_LIBRARY_ROUTE_GRADE_DESC</option>
            <option value="a.distance_km ASC">COM_RA_LIBRARY_ROUTE_DISTANCE_ASC</option>
            <option value="a.distance_km DESC">COM_RA_LIBRARY_ROUTE_DISTANCE_DESC</option>
        </field>

        <field name="limit"
               type="limitbox"
               label="COM_RA_LIBRARY_LIST_LIMIT"
               description="COM_RA_LIBRARY_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>
</form>
